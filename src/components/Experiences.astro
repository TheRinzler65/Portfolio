---
import { skillsReseau, skillsDev, experiences } from "../data/experiences";
---

<section class="py-16 px-4 max-w-7xl mx-auto" id="experiences">
  <div class="mb-8 md:mb-12">
    <h2 class="font-mono text-sm text-primary tracking-widest uppercase mb-2">
      // experiences
    </h2>
  </div>

  <div class="flex flex-col lg:flex-row gap-12 mt-12">
    <div class="lg:w-1/3">
      <div
        class="sticky top-24 bg-surface-raised p-8 rounded-2xl border border-border"
      >
        <h3
          class="font-mono text-xs text-primary tracking-widest uppercase mb-8 text-center"
        >
          compétences
        </h3>

        <div class="mb-8">
          <h4
            class="flex items-center gap-2 text-lg font-semibold mb-6 text-text-muted border-b border-border pb-2"
          >
            Infrastructure & Reseau
          </h4>
          <div
            class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-2 xl:grid-cols-3 gap-4"
          >
            {
              skillsReseau.map((skill) => (
                <div class="flex flex-col items-center group cursor-default">
                  <div class="w-16 h-16 p-3 rounded-xl bg-surface border border-border transition-all duration-300 group-hover:border-primary group-hover:scale-110 flex items-center justify-center">
                    <img
                      src={skill.image}
                      alt={skill.name}
                      class="object-contain w-full h-full"
                      loading="lazy"
                      width="64"
                      height="64"
                    />
                  </div>
                  <span class="mt-2 font-mono text-xs font-semibold text-center text-text-muted group-hover:text-primary transition-colors">
                    {skill.name}
                  </span>
                </div>
              ))
            }
          </div>
        </div>

        <div>
          <h4
            class="flex items-center gap-2 text-lg font-semibold mb-6 text-text-muted border-b border-border pb-2"
          >
            Developpement
          </h4>
          <div
            class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-2 xl:grid-cols-3 gap-4"
          >
            {
              skillsDev.map((skill) => (
                <div class="flex flex-col items-center group cursor-default">
                  <div class="w-16 h-16 p-3 rounded-xl bg-surface border border-border transition-all duration-300 group-hover:border-primary group-hover:scale-110 flex items-center justify-center">
                    <img
                      src={skill.image}
                      alt={skill.name}
                      class="object-contain w-full h-full"
                      loading="lazy"
                      width="64"
                      height="64"
                    />
                  </div>
                  <span class="mt-2 font-mono text-xs font-semibold text-center text-text-muted group-hover:text-primary transition-colors">
                    {skill.name}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div class="lg:w-2/3">
      <div
        class="relative border-l-4 border-primary/30 ml-4 md:ml-8 space-y-10"
      >
        {
          experiences.map((exp) => (
            <div class="relative pl-8 md:pl-12 group">
              <span class="absolute -left-3.5 top-1 flex items-center justify-center w-6 h-6 bg-primary rounded-full ring-4 ring-surface group-hover:scale-125 transition-transform duration-300" />

              <div class="bg-surface-raised p-6 md:p-8 rounded-2xl transition-all duration-300 border border-transparent hover:border-primary/30 flex flex-col sm:flex-row gap-6">
                {exp.image ? (
                  <div class="shrink-0">
                    <div class="w-16 h-16 bg-white rounded-xl p-2 shadow-sm flex items-center justify-center border border-border">
                      <img
                        src={exp.image}
                        alt={exp.company}
                        class="object-contain w-full h-full"
                        loading="lazy"
                        width="64"
                        height="64"
                      />
                    </div>
                  </div>
                ) : (
                  <div class="shrink-0">
                    <div class="w-16 h-16 bg-primary/10 rounded-xl flex items-center justify-center border border-primary/20 text-primary">
                      <svg
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        class="w-8 h-8"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M12 14l9-5-9-5-9 5 9 5z"
                        />
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"
                        />
                      </svg>
                    </div>
                  </div>
                )}

                <div class="flex-1">
                  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-2">
                    <h3 class="text-2xl font-bold text-text group-hover:text-primary transition-colors">
                      {exp.role}
                    </h3>
                    <span class="flex items-center gap-2 font-mono text-xs bg-primary/10 text-primary px-3 py-1 rounded-full w-fit">
                      {exp.period}
                    </span>
                  </div>
                  <h4 class="text-lg font-semibold text-text-muted mb-4">
                    {exp.company}
                  </h4>
                  <ul class="space-y-2 text-base text-text-muted">
                    {exp.description.map((desc: string) => (
                      <li class="flex items-start gap-2">
                        <span class="text-primary mt-1.5">$</span>
                        <span>{desc}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
