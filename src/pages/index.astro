---
import BaseLayout from "../layouts/BaseLayout.astro";
import About from "../components/About.astro";
import Experiences from "../components/Experiences.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const sortedProjects = projects.sort(
  (a, b) => (b.data.id ?? 0) - (a.data.id ?? 0),
);
---

<BaseLayout>
  <section
    id="home"
    class="min-h-[85vh] flex flex-col-reverse lg:flex-row justify-center items-center gap-12 py-12 px-4 max-w-7xl mx-auto"
  >
    <div class="flex flex-col lg:w-1/2 relative z-10">
      <div
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 text-primary font-mono text-xs tracking-widest uppercase w-fit mb-6 border border-primary/20"
      >
        <span>licence informatique — lid, dole</span>
      </div>

      <h1
        class="text-5xl md:text-6xl lg:text-7xl font-extrabold mb-6 tracking-tight text-text"
      >
        Bonjour, je suis <br class="hidden md:block" />
        <span class="text-primary">Leo Gruet</span>
      </h1>

      <p
        class="text-lg md:text-xl mb-10 text-text-muted leading-relaxed max-w-2xl"
      >
        Diplômé en <strong class="text-text">BTS SIO SISR</strong>, je rejoins la
        <strong class="text-text"> Licence Informatique (LID)</strong> à Dole à partir de septembre.
        Je bosse sur l'infra, le réseau et l'automatisation — et je code quand c'est utile.
      </p>

      <div
        class="flex flex-col sm:flex-row justify-center md:justify-start gap-4"
      >
        <button
          id="hero-contact-btn"
          class="bg-primary hover:bg-primary-hover text-surface font-semibold px-8 py-3 rounded-xl shadow-lg hover:shadow-primary/20 hover:-translate-y-1 transition-all flex items-center gap-2 justify-center cursor-pointer"
        >
          Me contacter
        </button>
        <a
          href="#projets"
          class="border border-primary text-primary font-semibold px-8 py-3 rounded-xl hover:-translate-y-1 transition-all flex items-center gap-2 justify-center"
        >
          Mes projets
        </a>
      </div>
    </div>

    <div
      class="lg:w-1/2 flex justify-center items-center relative mt-8 lg:mt-0"
    >
      <div class="relative group">
        <div
          class="absolute -inset-2 bg-primary/10 rounded-3xl blur opacity-50 group-hover:opacity-80 transition duration-500"
        >
        </div>
        <img
          src="/assets/profile.jpg"
          alt="Portrait de Leo Gruet"
          class="relative w-64 h-64 sm:w-80 sm:h-80 md:w-104 md:h-104 object-cover rounded-3xl border-4 border-surface shadow-2xl transition-transform duration-500 group-hover:scale-[1.02] -rotate-2 group-hover:rotate-0"
          width="640"
          height="640"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <About />

  <Experiences />

  <section class="py-16 px-4 max-w-7xl mx-auto" id="projets">
    <div class="mb-8 md:mb-12">
      <h2 class="font-mono text-sm text-primary tracking-widest uppercase mb-2">
        // projets
      </h2>
      <p class="text-lg text-text-muted">Mes réalisations principales</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-10">
      {sortedProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
