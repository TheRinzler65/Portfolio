---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Badge from "../../components/ui/Badge.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
---

<BaseLayout
  title={`${data.title} — Portfolio`}
  description={data.description || `Projet ${data.title} - Léo Gruet`}
>
  <section class="py-16 px-4 max-w-4xl mx-auto">
    <a
      href="/#projets"
      class="inline-flex items-center gap-2 font-mono text-sm text-primary hover:text-primary-hover mb-8 transition-colors"
    >
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-4 h-4"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 19l-7-7 7-7"></path></svg
      >
      retour
    </a>

    {
      data.imageproject && (
        <div class="aspect-video bg-surface-raised border border-border rounded-2xl overflow-hidden mb-8">
          <img
            src={data.imageproject}
            alt={data.title}
            class="w-full h-full object-contain"
            loading="lazy"
          />
        </div>
      )
    }

    <div class="flex items-center gap-3 mb-4">
      {data.year && <Badge>{data.year}</Badge>}
      {
        data.location && (
          <span class="font-mono text-xs text-text-muted">{data.location}</span>
        )
      }
    </div>

    <h1 class="text-4xl md:text-5xl font-extrabold text-text mb-6">
      {data.title}
    </h1>

    <div
      class="prose prose-invert prose-neutral max-w-none mb-8 prose-headings:text-text prose-p:text-text-muted prose-a:text-primary prose-strong:text-text prose-li:text-text-muted prose-code:text-primary"
    >
      <Content />
    </div>

    {
      data.team && (
        <div class="bg-surface-raised border border-border rounded-2xl p-6 mb-8">
          <h2 class="font-mono text-xs text-primary tracking-widest uppercase mb-4">
            équipe
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {data.team.network.length > 0 && (
              <div>
                <h3 class="font-mono text-xs text-text-muted mb-2">
                  // infrastructure & réseau
                </h3>
                <ul class="space-y-1">
                  {data.team.network.map((name: string) => (
                    <li class="text-sm text-text-muted">{name}</li>
                  ))}
                </ul>
              </div>
            )}
            {data.team.dev.length > 0 && (
              <div>
                <h3 class="font-mono text-xs text-text-muted mb-2">
                  // développement
                </h3>
                <ul class="space-y-1">
                  {data.team.dev.map((name: string) => (
                    <li class="text-sm text-text-muted">{name}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      )
    }

    {
      data.technologies.length > 0 && (
        <div class="mb-8">
          <h2 class="font-mono text-xs text-primary tracking-widest uppercase mb-4">
            technologies
          </h2>
          <div class="flex flex-wrap gap-3">
            {data.technologies.map((tech) => (
              <div class="flex items-center gap-2 bg-surface-raised border border-border rounded-lg px-3 py-2">
                <img
                  src={tech.logo}
                  alt={tech.name}
                  style="width:24px;height:24px;min-width:24px;min-height:24px;max-width:24px;max-height:24px;object-fit:contain"
                  loading="lazy"
                />
                <span class="font-mono text-sm text-text-muted">
                  {tech.name}
                </span>
              </div>
            ))}
          </div>
        </div>
      )
    }

    {
      data.documents.length > 0 && (
        <div class="mb-8">
          <h2 class="font-mono text-xs text-primary tracking-widest uppercase mb-4">
            documents
          </h2>
          <div class="flex flex-col gap-2">
            {data.documents.map((doc) => (
              <a
                href={doc.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 bg-surface-raised border border-border rounded-lg p-3 hover:border-primary/50 transition-colors group"
              >
                <svg
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  class="w-5 h-5 text-primary"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"
                  />
                </svg>
                <span class="font-mono text-sm text-text-muted group-hover:text-primary transition-colors">
                  {doc.title}
                </span>
              </a>
            ))}
          </div>
        </div>
      )
    }

    <div class="flex gap-4">
      {
        data.repoLink && data.repoLink !== "#" && (
          <a
            href={data.repoLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-surface-overlay hover:bg-border text-text-muted font-medium px-6 py-3 rounded-xl transition-colors font-mono text-sm"
          >
            <svg fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
            </svg>
            code source
          </a>
        )
      }
      {
        data.demoLink && data.demoLink !== "#" && (
          <a
            href={data.demoLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-primary hover:bg-primary-hover text-surface font-semibold px-6 py-3 rounded-xl transition-colors"
          >
            demo live
            <svg
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              class="w-4 h-4"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              />
            </svg>
          </a>
        )
      }
    </div>
  </section>
</BaseLayout>
